# Optional (Expo) public env overrides for Phase-3 server feed
# If you don't use env files, you can keep using the defaults in:
#   lib/appwrite/config.ts

EXPO_PUBLIC_SERVER_HOME_FEED=1
EXPO_PUBLIC_APPWRITE_FEED_FUNCTION_ID=69851d10000d231b66b3
EXPO_PUBLIC_APPWRITE_FEED_EVENTS_FUNCTION_ID=6985241c000f43efd797

# Optional: In-app password reset without knowing the old password.
# Create an Appwrite Function (Node) that updates the caller's password via Users API,
# then put its Function ID here.
EXPO_PUBLIC_APPWRITE_PASSWORD_RESET_FUNCTION_ID=
